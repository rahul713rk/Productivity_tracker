# Use Ubuntu 22.04 as it's a stable base for many Linux distributions
FROM ubuntu:22.04

# Avoid interaction during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    wget \
    curl \
    git \
    file \
    dpkg-dev \
    fuse \
    libfuse2 \
    libgl1-mesa-glx \
    libegl1-mesa \
    libxrender1 \
    libxi6 \
    libsm6 \
    libice6 \
    libfontconfig1 \
    libdbus-1-3 \
    libxcb-cursor0 \
    libxcb-xinerama0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxkbcommon-x11-0 \
    libwayland-client0 \
    libwayland-cursor0 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# We don't copy the whole directory here because we'll mount it at runtime
# but we can pre-install requirements if they exist
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Entry point will be the build script
ENTRYPOINT ["bash", "/app/build.sh"]
